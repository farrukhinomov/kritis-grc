# Copy to .env for local development. Real environments set these variables directly.
APP_ENV=local
# At least 50 random characters, e.g.: uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DATABASE_URL=postgres://grc:grc@localhost:5432/grc
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
