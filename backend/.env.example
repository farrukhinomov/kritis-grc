# Copy to .env for local development. Real environments set these variables directly.
APP_ENV=local
# At least 50 random characters, e.g.: uv run python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DATABASE_URL=postgres://grc:grc@localhost:5432/grc
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
# The password-less demo login; only for a Demo Tenant, off unless set.
DEMO_LOGIN_ENABLED=false
# S3-compatible store for Evidence files (SeaweedFS locally, R2 in the demo). Unset, uploads answer 503.
# STORAGE_ENDPOINT_URL=http://localhost:8333
# STORAGE_PUBLIC_ENDPOINT_URL=
# STORAGE_BUCKET=evidence
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# The risk engine that calculates Residual Ratings; required in production. Unset, Risks stay pending.
# RISK_ENGINE_URL=http://localhost:8080
