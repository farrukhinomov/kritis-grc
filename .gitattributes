# Normalize line endings to LF in the repository, regardless of the contributor's OS.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.woff binary
*.woff2 binary

# Lockfiles: don't show diffs in reviews; treat as generated.
uv.lock linguist-generated=true -diff
pnpm-lock.yaml linguist-generated=true -diff
