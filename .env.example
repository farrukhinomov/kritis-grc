# Local values for docker compose. Copy to .env (never committed) and fill in the blanks.

# Postgres: the owner role runs migrations, the app role serves requests.
POSTGRES_OWNER_PASSWORD=
APP_DB_PASSWORD=

# At least 50 random characters, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# S3-compatible storage for the production-like stack (any values, local only).
S3_ACCESS_KEY=
S3_SECRET_KEY=
